{
  "name": "receivy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": "11.5.3"
  },
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "turbo dev --filter=!@receivy/mobile",
    "dev:api": "turbo dev --filter=@receivy/api",
    "dev:web": "turbo dev --filter=@receivy/web",
    "dev:mobile": "turbo dev --filter=@receivy/mobile",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "build": "turbo build",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "verify:mobile-sdk": "node scripts/verify-expo-doctor.mjs",
    "verify": "pnpm verify:workspace && pnpm lint && pnpm check-types && pnpm test && pnpm build && pnpm verify:mobile-sdk",
    "format": "biome format --write .",
    "lint:biome": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "turbo": "^2.9.18",
    "typescript": "catalog:"
  }
}
