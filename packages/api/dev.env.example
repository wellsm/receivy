# Template for packages/api/dev.env (git-ignored): the `dev` EZ4 stage deployed to AWS,
# consumed by the web at https://receivy.wellsm.dev and by development builds.
# Copy to dev.env, replace every <...> and never commit real values. Secrets must be
# independent 32-byte random values, different from local.env and from prd.env.
# Where each value comes from, step by step: docs/deploy-guide.md.
APP_STAGE=dev
APP_DEBUG=false

# Step 1: IAM user `receivy-deploy` access key; one region for everything.
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>

# Step 2: Neon branch `dev` connection string.
EZ4_RAW_PG_DB_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

AUTH_JWT_SECRET=<32-byte-random>
LOGIN_CODE_HASH_KEY=<32-byte-random>
AUTH_ACCESS_TOKEN_TTL_SECONDS=86400
PUBLIC_LINK_HMAC_SECRET=<32-byte-random>
APPLE_CREDENTIAL_ENCRYPTION_KEY_B64=<32-byte-random-base64>

# Web origin of this stage. Drives public links, notification deep links and CORS.
PUBLIC_WEB_ORIGIN=https://receivy.wellsm.dev
# Exact destinations allowed after the provider callback: web done route + native scheme.
OAUTH_REDIRECT_ALLOW_LIST=https://receivy.wellsm.dev/auth/oauth/callback,receivy://auth/callback
# Social login (docs/oauth-setup.md, deploy-guide step 8). A provider is on only when its flag is
# `true` and every key it needs is set; `disabled` counts as unset. Callbacks derive from
# PUBLIC_WEB_ORIGIN and land on the WEB domain, which bridges them to this API:
#   Google redirect URI = https://receivy.wellsm.dev/api/auth/google/callback
#   Apple Return URL    = https://receivy.wellsm.dev/api/auth/apple/callback
GOOGLE_SIGNIN_ENABLED=true
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
APPLE_SIGNIN_ENABLED=false
APPLE_CLIENT_ID=disabled
APPLE_NATIVE_CLIENT_ID=disabled
APPLE_TEAM_ID=disabled
APPLE_KEY_ID=disabled
APPLE_PRIVATE_KEY_B64=disabled

# Resend: verify the sending domain receivy.wellsm.dev first (docs/environments.md).
EMAIL_TRANSPORT=resend
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=Receivy <login@receivy.wellsm.dev>

# Push stays disabled until the Expo project and APNs/FCM credentials exist.
NOTIFICATION_PUSH_TRANSPORT=disabled
EXPO_ACCESS_TOKEN=disabled

# Checkout links: `live` talks to InfinitePay (creates real links, no API key needed), `sandbox` talks
# to a provider's sandbox (PagBank), `fake` answers in-process and points the link at the web's
# /dev/infinitepay page, `disabled` (default when absent) fails every link with PAYMENT_LINK_UNAVAILABLE.
# The API origin is the base of the webhook url the provider posts to; the URL `pnpm output:dev` prints
# for this stage.
PUBLIC_API_ORIGIN=https://<id>.execute-api.sa-east-1.amazonaws.com/dev-receivy-api
PAYMENT_METHOD_LINK=sandbox
# 32-byte random base64 key that seals every stored provider credential (PagBank tokens/Connect pairs).
# Independent per stage; changing it later makes every stored credential unreadable.
PAYMENT_CREDENTIAL_KEY_B64=<32-byte-random-base64>
