APP_STAGE=local
APP_DEBUG=true
EZ4_RAW_PG_DB_URL=postgresql://receivy:receivy@127.0.0.1:55434/receivy
# Development-only values. Generate independent 32-byte secrets for every deployed environment.
AUTH_JWT_SECRET=local-only-jwt-secret-change-before-deploy
LOGIN_CODE_HASH_KEY=local-only-code-hash-key-change-before-deploy
# Access token lifetime in seconds: one week locally, one day on dev, 15 minutes (900) in production.
AUTH_ACCESS_TOKEN_TTL_SECONDS=604800
PUBLIC_LINK_HMAC_SECRET=local-only-public-link-secret-change-before-deploy
# Mail lands in the Mailpit container from docker-compose.yml; the mailbox UI is at
# http://127.0.0.1:8025. Both `mailpit` and `file` are refused outside local/test.
EMAIL_TRANSPORT=mailpit
MAILPIT_API_URL=http://127.0.0.1:8025
RESEND_API_KEY=disabled
RESEND_FROM_EMAIL=Receivy <login@receivy.local>
# Social login (docs/oauth-setup.md). A provider shows its button only when its flag is `true` and every
# key it needs is set; `disabled` counts as unset. Callbacks derive from PUBLIC_WEB_ORIGIN (default
# http://localhost:3000): register http://localhost:3000/api/auth/google/callback in the Google client.
GOOGLE_SIGNIN_ENABLED=true
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
# Apple refuses localhost callbacks: keep it off locally.
APPLE_SIGNIN_ENABLED=false
APPLE_CLIENT_ID=disabled
APPLE_NATIVE_CLIENT_ID=disabled
APPLE_TEAM_ID=disabled
APPLE_KEY_ID=disabled
APPLE_PRIVATE_KEY_B64=disabled
OAUTH_REDIRECT_ALLOW_LIST=http://localhost:3000/auth/oauth/callback,receivy://auth/callback
# InfinitePay checkout links: `PAYMENT_METHOD_LINK=live` talks to InfinitePay (creates real links, no
# API key needed), `fake` answers in-process and points the link at the web's /dev/infinitepay page,
# `disabled` (default when absent) fails every link with PAYMENT_LINK_UNAVAILABLE. The API origin is
# the base of the webhook url.
PUBLIC_API_ORIGIN=http://127.0.0.1:3735/local-receivy-api
PAYMENT_METHOD_LINK=fake
