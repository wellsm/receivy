APP_STAGE=local
APP_DEBUG=true
EZ4_RAW_PG_DB_URL=postgresql://receivy:receivy@127.0.0.1:55434/receivy
# Development-only values. Generate independent 32-byte secrets for every deployed environment.
AUTH_JWT_SECRET=local-only-jwt-secret-change-before-deploy
LOGIN_CODE_HASH_KEY=local-only-code-hash-key-change-before-deploy
# Access token lifetime in seconds: one week locally, one day on dev, 15 minutes (900) in production.
AUTH_ACCESS_TOKEN_TTL_SECONDS=604800
PUBLIC_LINK_HMAC_SECRET=local-only-public-link-secret-change-before-deploy
# Mail lands in the Mailpit container from docker-compose.yml; the mailbox UI is at
# http://127.0.0.1:8025. Both `mailpit` and `file` are refused outside local/test.
EMAIL_TRANSPORT=mailpit
MAILPIT_API_URL=http://127.0.0.1:8025
RESEND_API_KEY=disabled
RESEND_FROM_EMAIL=Receivy <login@receivy.local>
# Social login (docs/oauth-setup.md). A provider shows its button only when its flag is `true` and every
# key it needs is set; `disabled` counts as unset. Callbacks derive from PUBLIC_WEB_ORIGIN (default
# http://localhost:3000): register http://localhost:3000/api/auth/google/callback in the Google client.
GOOGLE_SIGNIN_ENABLED=true
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
# Apple refuses localhost callbacks: keep it off locally.
APPLE_SIGNIN_ENABLED=false
APPLE_CLIENT_ID=disabled
APPLE_NATIVE_CLIENT_ID=disabled
APPLE_TEAM_ID=disabled
APPLE_KEY_ID=disabled
APPLE_PRIVATE_KEY_B64=disabled
OAUTH_REDIRECT_ALLOW_LIST=http://localhost:3000/auth/oauth/callback,receivy://auth/callback
# Checkout links (InfinitePay, PagBank): `PAYMENT_METHOD_LINK=live` talks to both providers for real
# (InfinitePay has no sandbox of its own, so `live` and `sandbox` hit the same host there), `sandbox`
# talks to PagBank's sandbox host, `fake` answers in-process and points the link at the web's
# /dev/checkout/<provider> page, `disabled` (default when absent) fails every link with
# PAYMENT_LINK_UNAVAILABLE. The API origin is the base of the webhook url.
PUBLIC_API_ORIGIN=http://127.0.0.1:3735/local-receivy-api
PAYMENT_METHOD_LINK=fake
# 32 bytes base64; local/test only — generate one per stage with `openssl rand -base64 32`;
# changing it later makes every stored provider credential unreadable.
PAYMENT_CREDENTIAL_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Paid plan: `live` talks to Stripe with the keys below, `fake` activates a subscription in-process
# (no card, no webhook), `disabled` (default) answers 503 on every plan action while the free limits still apply.
PLAN_BILLING=fake

# WhatsApp — Receivy number. `disabled` | `file` (.ez4/whatsapp) | `whap` (docker) | `meta` (real, billed).
# whap and file refuse to run when APP_STAGE=prd.
# whap posts status webhooks to http://host.docker.internal:3735/<APP_STAGE>-receivy-api/webhooks/whatsapp/meta;
# docker-compose.yml assumes APP_STAGE=local — edit WEBHOOK_URL there if yours differs.
WHATSAPP_TRANSPORT=whap
WHAP_API_URL=http://127.0.0.1:3011
WHAP_PHONE_NUMBER_ID=000000000000000
# Meta Cloud API, read only by the meta transport.
WHATSAPP_ACCESS_TOKEN=disabled
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_API_VERSION=v21.0
# Webhook GET /webhooks/whatsapp/meta: typed the same in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=whatsapp_verify_token_local
# Webhook POST: the app secret that signs X-Hub-Signature-256. Compose's whap uses the same value.
WHATSAPP_APP_SECRET=whatsapp_app_secret_local
# Template names on the WABA; change here to roll a new version without a deploy.
WHATSAPP_TEMPLATE_INITIAL=receivy_charge_initial
WHATSAPP_TEMPLATE_REMINDER=receivy_charge_reminder
WHATSAPP_TEMPLATE_MANUAL=receivy_charge_manual

# WhatsApp — owner's own number through Evolution API (docker). The global key only creates and
# deletes instances; each instance carries its own token.
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=evolution_local_key
# Existing receivy_pg_data volume: docker exec receivy-pg psql -U receivy -c 'CREATE DATABASE evolution'
