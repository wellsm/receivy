APP_STAGE=local
APP_DEBUG=true
EZ4_RAW_PG_DB_URL=postgresql://receivy:receivy@127.0.0.1:55434/receivy
# Development-only values. Generate independent 32-byte secrets for every deployed environment.
AUTH_JWT_SECRET=local-only-jwt-secret-change-before-deploy
LOGIN_CODE_HASH_KEY=local-only-code-hash-key-change-before-deploy
PUBLIC_LINK_HMAC_SECRET=local-only-public-link-secret-change-before-deploy
# Mail lands in the Mailpit container from docker-compose.yml; the mailbox UI is at
# http://127.0.0.1:8025. Both `mailpit` and `file` are refused outside local/test.
EMAIL_TRANSPORT=mailpit
MAILPIT_API_URL=http://127.0.0.1:8025
RESEND_API_KEY=disabled
RESEND_FROM_EMAIL=Receivy <login@receivy.local>
# Base64url-encoded provider JSON. Keep disabled until real credentials exist.
OAUTH_PROVIDERS_CONFIG_B64=disabled
OAUTH_GOOGLE_ENABLED=false
OAUTH_APPLE_ENABLED=false
OAUTH_REDIRECT_ALLOW_LIST=http://localhost:3000/auth/oauth/callback,receivy://auth/callback
