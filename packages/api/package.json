{
  "name": "@receivy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/generate-openapi.mjs --check",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "node --env-file=local.env ./node_modules/@ez4/project/bin/cli.mjs serve -e local.env --local",
    "serve:dev": "APP_STAGE=dev node --env-file=dev.env --env-file-if-exists=local-dev.env ./node_modules/@ez4/project/bin/cli.mjs serve -e dev.env",
    "serve:prd": "APP_STAGE=prd node --env-file=prd.env ./node_modules/@ez4/project/bin/cli.mjs serve -e prd.env",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && biome check .",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --pool=forks",
    "test:watch": "vitest src --pool=forks",
    "test:db:prepare": "node --env-file=test.env.example scripts/prepare-test-database.mjs",
    "test:integration": "pnpm run test:db:prepare && node --env-file=test.env.example ./node_modules/@ez4/project/bin/cli.mjs test -e test.env.example --local --reset -- test/",
    "test:http-smoke": "node scripts/financial-http-smoke.mjs",
    "check-types:test": "tsc -p tsconfig.test.json --noEmit",
    "output:dev": "APP_STAGE=dev ez4 output -e dev.env",
    "deploy:dev": "tsc -p tsconfig.json --noEmit && APP_STAGE=dev ez4 deploy -e dev.env",
    "deploy:prd": "tsc -p tsconfig.json --noEmit && APP_STAGE=prd ez4 deploy -e prd.env"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@ez4/common": "0.52.0",
    "@ez4/database": "0.52.0",
    "@ez4/factory": "0.52.0",
    "@ez4/gateway": "0.52.0",
    "@ez4/pgclient": "0.52.0",
    "@ez4/project": "0.52.0",
    "@ez4/raw-pg": "0.52.0",
    "@ez4/scheduler": "0.52.0",
    "@ez4/schema": "0.52.0",
    "@ez4/storage": "0.52.0",
    "@receivy/common": "workspace:*"
  },
  "devDependencies": {
    "@ez4/aws-bucket": "0.52.0",
    "@ez4/aws-gateway": "0.52.0",
    "@ez4/local-database": "0.52.0",
    "@ez4/local-gateway": "0.52.0",
    "@ez4/local-scheduler": "0.52.0",
    "@ez4/local-storage": "0.52.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
