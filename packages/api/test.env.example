APP_STAGE=test
APP_DEBUG=false
AUTH_JWT_SECRET=test-only-jwt-secret
LOGIN_CODE_HASH_KEY=test-only-login-code-key
EMAIL_TRANSPORT=disabled
RESEND_API_KEY=disabled
RESEND_FROM_EMAIL=disabled@example.invalid
PUBLIC_WEB_ORIGIN=http://localhost:3000
GOOGLE_SIGNIN_ENABLED=false
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
APPLE_SIGNIN_ENABLED=false
APPLE_CLIENT_ID=disabled
APPLE_NATIVE_CLIENT_ID=disabled
APPLE_TEAM_ID=disabled
APPLE_KEY_ID=disabled
APPLE_PRIVATE_KEY_B64=disabled
OAUTH_REDIRECT_ALLOW_LIST=http://localhost:3000/auth/oauth/callback
PUBLIC_LINK_HMAC_SECRET=test-only-public-link-secret
# Checkout links (InfinitePay, PagBank): `PAYMENT_METHOD_LINK=live` talks to both providers for real
# (InfinitePay has no sandbox of its own, so `live` and `sandbox` hit the same host there), `sandbox`
# talks to PagBank's sandbox host, `fake` answers in-process and points the link at the web's
# /dev/checkout/<provider> page, `disabled` (default when absent) fails every link with
# PAYMENT_LINK_UNAVAILABLE. The API origin is the base of the webhook url.
PUBLIC_API_ORIGIN=http://127.0.0.1:3735/local-receivy-api
PAYMENT_METHOD_LINK=fake
# 32 bytes base64; local/test only — generate one per stage with `openssl rand -base64 32`;
# changing it later makes every stored provider credential unreadable.
PAYMENT_CREDENTIAL_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Paid plan: `live` talks to Stripe with the keys below, `fake` activates a subscription in-process
# (no card, no webhook), `disabled` (default) answers 503 on every plan action while the free limits still apply.
PLAN_BILLING=fake
EZ4_TEST_PG_HOST=127.0.0.1
EZ4_TEST_PG_PORT=55434
EZ4_TEST_PG_USER=receivy
EZ4_TEST_PG_PASSWORD=receivy
