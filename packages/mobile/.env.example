# iOS Simulator. Use http://10.0.2.2:3735/local-receivy-api on Android Emulator.
# On a physical device, use the development machine's reachable LAN address.
EXPO_PUBLIC_EZ4_API_URL=http://127.0.0.1:3735/local-receivy-api

# Public links must point to the separately deployed web app, never the API gateway.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Development build against the deployed dev stage (docs/environments.md):
# EXPO_PUBLIC_EZ4_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/dev-receivy-api
# EXPO_PUBLIC_WEB_URL=https://receivy.wellsm.dev
