{
  "expo": {
    "name": "Receivy",
    "slug": "receivy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-light.png",
    "scheme": "receivy",
    "ios": {
      "icon": {
        "light": "./assets/icons/ios-light.png",
        "dark": "./assets/icons/ios-dark.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "bundleIdentifier": "com.wellingtonsm.receivy",
      "appleTeamId": "HU9JULKT2H"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D5A45",
        "foregroundImage": "./assets/icons/adaptative-icon.png",
        "monochromeImage": "./assets/icons/adaptative-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wellingtonsm.receivy"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#faf8ff",
          "dark": {
            "image": "./assets/icons/splash-icon-dark.png",
            "backgroundColor": "#0B513D"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
