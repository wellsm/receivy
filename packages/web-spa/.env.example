# Copy to .env.local (local) or inject in the runtime environment (deployed).
# Every VITE_* variable here is inlined into the browser bundle at build time.

# Base URL of the EZ4 API for this environment (stage path included).
#   local: http://127.0.0.1:3735/local-receivy-api
#   dev:   https://<api-id>.execute-api.<region>.amazonaws.com/dev-receivy-api
VITE_API_URL=http://127.0.0.1:3735/local-receivy-api

# Exact origin of the proof upload target allowed in the public page CSP.
#   serve --local: the API host, which also serves the ProofFiles bucket: http://localhost:3735
#   deployed: the S3 upload origin printed by the API (docs/proof-storage.md)
VITE_PROOF_UPLOAD_ORIGIN=http://localhost:3735

# Exact origin of the AvatarFiles bucket allowed in the CSP. With both bucket origins set, the CSP lists only them;
# with either empty it keeps the regional S3 wildcard (the build warns).
#   serve --local: http://localhost:3735
#   deployed: https://<avatar bucket name>.s3.sa-east-1.amazonaws.com (bucket name from the API `ez4 output`)
VITE_AVATAR_ORIGIN=http://localhost:3735

# Shown on the legal pages.
VITE_OPERATOR_CONTACT=

# Kill switch for every WhatsApp mention (reminders, contact consent). Only the string "true" turns it on.
# Either this or VITE_EVOLUTION_ENABLED being on is enough to keep WhatsApp mentions visible.
VITE_WHATSAPP_ENABLED=false

# The "Meu número" (own number, via Evolution) sender option. Only the string "true" turns it on.
VITE_EVOLUTION_ENABLED=false

# Stripe.js for the paid plan page (public key, safe in the browser). Empty = plan page shows "unavailable".
VITE_STRIPE_PUBLISHABLE_KEY=
# Display price of the Básico plan in cents (the real charge is the Stripe price). Empty = amount hidden.
VITE_PLAN_BASIC_PRICE_CENTS=
