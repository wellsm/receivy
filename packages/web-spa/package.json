{
  "name": "@receivy/web-spa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "build": "vite build",
    "build:dev": "node --env-file=dev.env ./node_modules/vite/bin/vite.js build",
    "build:prd": "node --env-file=prd.env ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview --port 3000",
    "lint": "eslint .",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --pool=forks",
    "test:watch": "vitest --pool=forks",
    "deploy:dev": "pnpm run check-types && pnpm run build:dev && APP_STAGE=dev ez4 deploy -e dev.env",
    "deploy:prd": "pnpm run check-types && pnpm run build:prd && APP_STAGE=prd ez4 deploy -e prd.env",
    "output:dev": "APP_STAGE=dev ez4 output -e dev.env",
    "output:prd": "APP_STAGE=prd ez4 output -e prd.env"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@receivy/common": "workspace:*",
    "@stripe/react-stripe-js": "^6.10.0",
    "@stripe/stripe-js": "^9.16.0",
    "@tanstack/react-router": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@ez4/aws-bucket": "0.53.0",
    "@ez4/aws-cloudfront": "0.53.0",
    "@ez4/common": "0.53.0",
    "@ez4/distribution": "0.53.0",
    "@ez4/project": "0.53.0",
    "@ez4/storage": "0.53.0",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "4.13.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "jsdom": "^27.0.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
