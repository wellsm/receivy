# Template for packages/web-spa/prd.env (git-ignored): the `prd` stage of the SPA (S3 + CloudFront).
# Copy to prd.env, fill the values and never commit real ones. Steps: docs/web-spa-deploy.md.
# The deploy script loads this file twice: `vite build` (VITE_* below) and `ez4 deploy` (AWS_*).
APP_STAGE=prd

# EZ4 deploy credentials: same IAM user and region as the API stage.
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Build variables: inlined into the browser bundle by `vite build`. Copy the API values from
# `pnpm --filter @receivy/api output:prd`.
# API Gateway URL with the stage path. Required: the build fails without it (it goes into the CSP too).
VITE_API_URL=https://<api-id>.execute-api.sa-east-1.amazonaws.com/prd-receivy-api
# S3 origin of the proof bucket, only when the presigned URL is not https://<bucket>.s3.sa-east-1.amazonaws.com.
VITE_PROOF_UPLOAD_ORIGIN=
# Contact e-mail shown on the legal pages.
VITE_OPERATOR_CONTACT=
# "true" shows the WhatsApp options that use the Receivy number (needs WHATSAPP_TRANSPORT on the API).
VITE_WHATSAPP_ENABLED=false
# "true" shows the "Meu número" option (needs EVOLUTION_API_URL/KEY on the API).
VITE_EVOLUTION_ENABLED=false
# Stripe publishable key (pk_...). Empty: the plan page says subscriptions are unavailable.
VITE_STRIPE_PUBLISHABLE_KEY=
# Display price of the Básico plan in cents (4990). Empty: the amount is hidden.
VITE_PLAN_BASIC_PRICE_CENTS=
