# Server-side only. Copy to .env.local (local) or inject in the runtime environment (deployed).
# Nothing here reaches the browser bundle.

# Base URL of the EZ4 API for this environment (stage path included).
#   local: http://127.0.0.1:3735/local-receivy-api
#   dev:   https://<api-id>.execute-api.<region>.amazonaws.com/dev-receivy-api
EZ4_API_URL=http://127.0.0.1:3735/local-receivy-api

# Public origin of THIS web app, without trailing slash. Required behind a proxy or
# container: it pins the CSRF origin check, the OAuth destination and every redirect.
# Leave unset for plain `next dev` on localhost.
# WEB_APP_URL=https://receivy.wellsm.dev

# Exact origin of the proof upload target allowed in the public page CSP.
#   serve --local: the API host, which also serves the ProofFiles bucket: http://localhost:3735
#   deployed: the S3 upload origin printed by the API (docs/proof-storage.md)
PROOF_UPLOAD_ORIGIN=http://localhost:3735

# Shown on the legal pages.
NEXT_PUBLIC_OPERATOR_CONTACT=

# Stripe.js for the paid plan page (public key, safe in the browser). Empty = plan page shows "unavailable".
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Display price of the Básico plan in cents (the real charge is the Stripe price). Empty = amount hidden.
NEXT_PUBLIC_PLAN_BASIC_PRICE_CENTS=
