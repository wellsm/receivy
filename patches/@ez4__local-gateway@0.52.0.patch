+// Pinned Receivy local emulator parity. Never serialize the original exception.
+const { randomUUID } = require('node:crypto');
+module.exports = function receivyErrorResponse(status, traceId) {
+  const errors = {
+    400: ['INVALID_REQUEST', 'Invalid request.'], 401: ['UNAUTHENTICATED', 'Authentication required.'],
+    403: ['FORBIDDEN', 'Access denied.'], 404: ['NOT_FOUND', 'Resource not found.'],
+    409: ['CONFLICT', 'Conflicting request.'], 422: ['INVALID_REQUEST', 'Invalid request.'],
+    429: ['RATE_LIMITED', 'Too many requests.']
+  };
+  status = Number.isInteger(status) && status >= 400 && status <= 599 ? status : 500;
+  const [code, message] = errors[status] ?? ['INTERNAL_ERROR', 'Request failed.'];
+  const correlationId = typeof traceId === 'string' && /^[a-f0-9-]{36}$/.test(traceId) ? traceId : randomUUID();
+  return { status, body: JSON.stringify({ code, message, correlationId }), headers: {
+    'content-type': 'application/json', 'x-trace-id': correlationId,
+    'cache-control': 'private, no-store', 'referrer-policy': 'no-referrer'
+  } };
+};
